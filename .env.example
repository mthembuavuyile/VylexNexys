# ==============================================================================
# Vylex Nexys - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your environment variables.

# OpenRouter API Key
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model Identifier (default: openrouter/free for auto-routing)
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Application Metadata for OpenRouter headers
OPENROUTER_APP_NAME="Vylex Nexys AI Studio"
OPENROUTER_SITE_URL="https://vylexnexys.co.za"

# Optional Backend Proxy Endpoint (leave empty for direct client requests)
BACKEND_PROXY_URL=
